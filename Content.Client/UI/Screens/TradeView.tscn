[gd_scene format=3]
[ext_resource type="Theme" path="res://UI/Theme/rework-theme.tres" id="Theme"]
[node name="TradeView" type="VBoxContainer"]
theme = ExtResource("Theme")
size_flags_horizontal = 3
size_flags_vertical = 3
[node name="Phase" type="Label" parent="."]
unique_name_in_owner = true
text = "Обмен с игроком"
autowrap_mode = 3
size_flags_horizontal = 3
theme_type_variation = &"Heading"
theme_override_font_sizes/font_size = 22
[node name="Status" type="Label" parent="."]
unique_name_in_owner = true
text = "Выберите находящегося рядом игрока."
autowrap_mode = 3
size_flags_horizontal = 3
theme_type_variation = &"Muted"
[node name="Workspace" type="HBoxContainer" parent="."]
size_flags_horizontal = 3
size_flags_vertical = 3
[node name="PlayersPanel" type="VBoxContainer" parent="Workspace"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
size_flags_horizontal = 3
size_flags_vertical = 3
[node name="PlayersHeading" type="Label" parent="Workspace/PlayersPanel"]
text = "Игроки рядом"
autowrap_mode = 3
size_flags_horizontal = 3
theme_type_variation = &"Heading"
theme_override_font_sizes/font_size = 22
[node name="Players" type="ScrollContainer" parent="Workspace/PlayersPanel"]
size_flags_vertical = 3
size_flags_horizontal = 3
horizontal_scroll_mode = 0
[node name="PlayersRows" type="VBoxContainer" parent="Workspace/PlayersPanel/Players"]
unique_name_in_owner = true
size_flags_horizontal = 3
[node name="Offers" type="VBoxContainer" parent="Workspace"]
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_vertical = 3
size_flags_stretch_ratio = 2
[node name="Invitation" type="VBoxContainer" parent="Workspace/Offers"]
unique_name_in_owner = true
