theme_type_variation = &"Heading"
theme_override_font_sizes/font_size = 22
[node name="OwnItems" type="ScrollContainer" parent="Workspace/Offers/Active/OfferColumns/Own"]
size_flags_vertical = 3
size_flags_horizontal = 3
horizontal_scroll_mode = 0
[node name="OwnItemsRows" type="VBoxContainer" parent="Workspace/Offers/Active/OfferColumns/Own/OwnItems"]
unique_name_in_owner = true
size_flags_horizontal = 3
[node name="Partner" type="VBoxContainer" parent="Workspace/Offers/Active/OfferColumns"]
size_flags_horizontal = 3
size_flags_vertical = 3
[node name="PartnerTitle" type="Label" parent="Workspace/Offers/Active/OfferColumns/Partner"]
