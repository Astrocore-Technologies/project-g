autowrap_mode = 3
size_flags_horizontal = 3
[node name="AcceptInvite" type="Button" parent="Workspace/Offers/Invitation"]
unique_name_in_owner = true
text = "Принять приглашение"
[node name="Active" type="VBoxContainer" parent="Workspace/Offers"]
unique_name_in_owner = true
size_flags_horizontal = 3
size_flags_vertical = 3
[node name="OfferColumns" type="HBoxContainer" parent="Workspace/Offers/Active"]
size_flags_horizontal = 3
size_flags_vertical = 3
[node name="Own" type="VBoxContainer" parent="Workspace/Offers/Active/OfferColumns"]
