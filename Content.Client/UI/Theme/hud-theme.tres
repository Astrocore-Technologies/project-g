PortraitButton/styles/hover = SubResource("Portrait")
PortraitButton/styles/pressed = SubResource("Portrait")
PortraitButton/constants/icon_max_width = 30
VBoxContainer/constants/separation = 4
HBoxContainer/constants/separation = 8
