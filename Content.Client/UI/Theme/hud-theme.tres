[resource]
default_font = SubResource("Font")
default_font_size = 13
Label/colors/font_color = Color(1, 0.976, 0.918, 1)
Label/colors/font_shadow_color = Color(0.01, 0.02, 0.02, 1)
Label/constants/shadow_offset_x = 1
Label/constants/shadow_offset_y = 1
PanelContainer/styles/panel = SubResource("Panel")
HudSlot/base_type = &"PanelContainer"
HudSlot/styles/panel = SubResource("Slot")
ProgressBar/styles/background = SubResource("Track")
HealthBar/base_type = &"ProgressBar"
HealthBar/styles/fill = SubResource("Health")
ManaBar/base_type = &"ProgressBar"
ManaBar/styles/fill = SubResource("Mana")
StaminaBar/base_type = &"ProgressBar"
StaminaBar/styles/fill = SubResource("Stamina")
ExperienceBar/base_type = &"ProgressBar"
ExperienceBar/styles/fill = SubResource("Experience")
